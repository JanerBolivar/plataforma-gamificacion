generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchStage {
  LOBBY
  SWAMP
  CIRCO
  FINISHED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CollectibleType {
  ADIVINALO
  CARTA_PREGUNTA
  TIBURON_AZUL
  TIBURON_ROJO
}

enum AvatarGender {
  FEMALE
  MALE
}

model User {
  id                   String            @id @default(uuid())
  microsoftId          String            @unique
  email                String            @unique
  firstName            String
  lastName             String
  role                 Role              @default(STUDENT)
  status               UserStatus        @default(PENDING)
  avatarGender         AvatarGender      @default(FEMALE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  createdMatches       Match[]           @relation("MatchCreator")
  matchParticipations  MatchParticipant[]
  sentInvitations      TeamInvitation[]  @relation("InvitationSender")
  receivedInvitations  TeamInvitation[]  @relation("InvitationReceiver")
}

model Match {
  id             String             @id @default(uuid())
  name           String
  maxTeams       Int
  maxTeamMembers Int                @default(6)
  status         MatchStatus        @default(WAITING)
  currentStage   MatchStage         @default(LOBBY)
  creatorId      String
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  circoCurrentTurnSeat Int           @default(1)
  circoArrowRotationY  Float         @default(0)

  creator        User               @relation("MatchCreator", fields: [creatorId], references: [id])
  teams          Team[]
  participants   MatchParticipant[]
  invitations    TeamInvitation[]
  collectibles   MatchCollectible[]
}

model MatchCollectible {
  id                 String          @id @default(uuid())
  matchId            String
  type               CollectibleType
  posX               Float
  posZ               Float
  collectedByTeamId  String?
  collectedAt        DateTime?
  createdAt          DateTime        @default(now())

  match              Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Team {
  id                    String             @id @default(uuid())
  name                  String
  score                 Int                @default(0)
  swampCompleted        Boolean            @default(false)
  matchId               String
  circoSeat             Int?
  circoRepresentativeId String?
  circoTokenPosition    Int                @default(0)
  circoOpportunities    Int                @default(0)
  createdAt             DateTime           @default(now())

  match        Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members      MatchParticipant[]
  invitations  TeamInvitation[]

  @@unique([matchId, name])
}

model MatchParticipant {
  id        String    @id @default(uuid())
  matchId   String
  userId    String
  teamId    String?
  joinedAt  DateTime  @default(now())

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([matchId, userId])
}

model TeamInvitation {
  id         String           @id @default(uuid())
  matchId    String
  teamId     String
  inviterId  String
  inviteeId  String
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  match      Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter    User             @relation("InvitationSender", fields: [inviterId], references: [id])
  invitee    User             @relation("InvitationReceiver", fields: [inviteeId], references: [id])
}
