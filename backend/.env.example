PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/gamificacion_db?schema=public"
CORS_ORIGIN="http://localhost:5173"

SWAMP_TIME_MINUTES=15
CIRCO_TIME_MINUTES=30
CIRCO_QUESTION_TIME_SECONDS=30

# Microsoft Entra ID (OAuth 2.0 / OIDC)
MICROSOFT_CLIENT_ID="tu-client-id-aqui"
MICROSOFT_CLIENT_SECRET="tu-client-secret-aqui"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/auth/microsoft/callback"

# Seguridad y JWT
JWT_SECRET="clave_secreta_para_firmar_jwt_debe_ser_larga_y_aleatoria"
JWT_EXPIRES_IN="8h"

# Administradores iniciales (separados por coma)
ADMIN_EMAILS="admin@dominio.com,coordinador@dominio.com"

# Redireccion de cliente Frontend
FRONTEND_URL="http://localhost:5173"
