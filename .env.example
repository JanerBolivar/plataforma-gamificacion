# ==============================================================================
# CONFIGURACION GENERAL Y DOMINIOS EN DOKPLOY / TRAEFIK
# ==============================================================================
NODE_ENV=production

# Dominios asignados en Dokploy para el enrutamiento del proxy inverso Traefik (puerto 80 / 443)
# Ejemplo: FRONTEND_DOMAIN=juego.tudominio.edu.co
# Ejemplo: BACKEND_DOMAIN=api-juego.tudominio.edu.co
FRONTEND_DOMAIN=juego.localhost
BACKEND_DOMAIN=api.localhost

# ==============================================================================
# BASE DE DATOS (PostgreSQL Interna)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_secure
POSTGRES_DB=gamificacion_db
DATABASE_URL=postgresql://postgres:postgres_password_secure@db:5432/gamificacion_db?schema=public

# ==============================================================================
# BACKEND API & SERVIDOR DE JUEGO MULTIJUGADOR (Express + Colyseus)
# ==============================================================================
PORT=4000
# En produccion bajo HTTP usar http://, si Dokploy tiene SSL activo usar https://
CORS_ORIGIN=http://juego.localhost
FRONTEND_URL=http://juego.localhost

# Microsoft Entra ID (Autenticacion institucional OAuth 2.0 / OIDC)
MICROSOFT_CLIENT_ID=tu-client-id-aqui
MICROSOFT_CLIENT_SECRET=tu-client-secret-aqui
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://api.localhost/api/auth/microsoft/callback

# Seguridad, Cookies HTTP-Only y Firma de Tokens JWT
JWT_SECRET=clave_secreta_para_firmar_jwt_debe_ser_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Administradores iniciales de la plataforma (correos separados por coma)
ADMIN_EMAILS=admin@dominio.com

# ==============================================================================
# CONFIGURACION DE ESCENARIOS Y MINIJUEGOS
# ==============================================================================
# Escenario 1: El Pantano
SWAMP_TIME_MINUTES=15

# Escenario 2: El Circo
CIRCO_TIME_MINUTES=30
CIRCO_QUESTION_TIME_SECONDS=30
CIRCO_GUESS_IT_TIME_SECONDS=90
CIRCO_SHARK_LETTER_TIME_SECONDS=90

# ==============================================================================
# FRONTEND WEB (Vite React SPA + Nginx)
# ==============================================================================
# URL del backend accesible desde el navegador del cliente (http:// o https://)
VITE_API_URL=http://api.localhost
