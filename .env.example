# Entorno general
NODE_ENV=production

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_secure
POSTGRES_DB=gamificacion_db
POSTGRES_PORT=5432

# Backend
PORT=4000
DATABASE_URL=postgresql://postgres:postgres_password_secure@db:5432/gamificacion_db?schema=public
CORS_ORIGIN=http://localhost:3000

# Microsoft Entra ID (OAuth 2.0 / OIDC)
MICROSOFT_CLIENT_ID=tu-client-id-aqui
MICROSOFT_CLIENT_SECRET=tu-client-secret-aqui
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback

# Seguridad y JWT
JWT_SECRET=clave_secreta_para_firmar_jwt_debe_ser_larga_y_aleatoria
JWT_EXPIRES_IN=8h
SWAMP_TIME_MINUTES=15

# Administradores iniciales (separados por coma)
ADMIN_EMAILS=admin@dominio.com

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
